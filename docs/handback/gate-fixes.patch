+def _reads_the_directory_state_it_is_given(shell, base):
+    """Does this shell resolve `~` out of the HOME THIS process hands it, in THIS filesystem?
+
+    THE PROPERTY THE MEASUREMENT BELOW NEEDS, AND `true` RETURNING 0 IS NOT IT. On Windows a `bash`
+    on PATH can be the WSL launcher, which starts a shell in another filesystem and another
+    environment: it runs `true` fine, it even sees the working directory, and the `HOME`, `OLDPWD`
+    and `CDPATH` this measurement sets never reach it. Every tilde line then lands in a tree that is
+    neither the sandbox nor the decoy, the control finds the decoy untouched, and the whole test
+    says nothing while looking like a measurement.
+
+    Measured 2026-08-11 on this host (BUG-0014): with `HOME` set to a directory of the measurement,
+    `printf "%s" ~` came back `/home/<user>` from `C:\\WINDOWS\\system32\\bash.exe` and the given
+    directory from `C:\\Program Files\\Git\\usr\\bin\\bash.exe`. WHICH of them was picked depended
+    on the PATH of the shell the suite was started from -- Git Bash first from a Git Bash, the WSL
+    launcher first from PowerShell -- so the same commit was red or green by launcher, and the red
+    survived a whole round without standing anywhere.
+
+    ASKED BY RUNNING IT, not by comparing path spellings: Git's bash answers a `C:/...` HOME with
+    its own `/c/...` reading, so the only thing that settles it is where the byte lands.
+    """
+    home = tempfile.mkdtemp(prefix="home-probe-", dir=base)
+    subprocess.run([shell, "-c", "printf x > ~/reached"], cwd=base, stdin=subprocess.DEVNULL,
+                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=120,
+                   env=dict(os.environ, HOME=_sandbox_module().posix(home)))
+    return os.path.isfile(os.path.join(home, "reached"))
+
