+# ONE CELL PER WORD OF `_harness._RESERVED_WORDS`: the compound the word really stands in, and the
+# GATE whose answer that word decides. The grammar AROUND a reserved word cannot be derived from the
+# word, so the compound is written down -- and the test below is what keeps the table and the set
+# from drifting: it asserts the keys are exactly the set the reader decides from, so a word added
+# there without a cell fails here and a cell for a word the reader does not know fails too.
+#
+# WHY THE GATE IS PART OF THE CELL. An opening word decides gate 1: the stage it opens is where the
+# protected path stands. A CLOSING word opens nothing and names no path, so gate 1 has nothing to
+# change its mind about -- what it decides is whether that stage counts as a command that could move
+# the working tree, which is gate 3's question. A single column would have made the two closing
+# words look dead.
+GATE1, GATE3 = "gate_lead_write_scope.py", "gate_commit_evidence.py"
+# `%s` is the command the compound carries.
+RESERVED_WORD_CELLS = {
+    "if": ("if %s ; then true ; fi", GATE1),
+    "elif": ("if false ; then true ; elif %s ; then true ; fi", GATE1),
+    "then": ("if true ; then %s ; fi", GATE1),
+    "else": ("if false ; then true ; else %s ; fi", GATE1),
+    "while": ("while %s ; do break ; done", GATE1),
+    "until": ("until %s ; do break ; done", GATE1),
+    # a loop that runs its body exactly once. `while true` never ends, a `for` head keeps a verb
+    # this reader does not drop (see `_harness._RESERVED_WORDS`), and a loop counter is a `$` the
+    # arbiter cannot carry (`_a_shell_that_hands_its_output_back`)
+    "do": ("while test 1 = 1 ; do %s ; break ; done", GATE1),
+    # `test 1 = 1` and not `true`: the kits' read-only classification does not know `true`, so an
+    # `if true` head would refuse this line for a reason that has nothing to do with `fi`
+    "fi": ("if test 1 = 1 ; then %s ; fi", GATE3),
+}
+# What is written into a copy of `_harness.py` to take one word back OUT of the reader's set. An
+# APPENDED rebinding rather than a rewrite of the line in the file: the constant is read when
+# `_behind_the_grammar` runs, so the last binding in the module is the one that decides, and no
+# search for a sentence in a file is needed to make the mutation land.
+_WITHOUT_A_WORD = "\n_RESERVED_WORDS = frozenset(%r)\n"
+
+
+def _hooks_without(tmp_path, project, word):
+    """A copy of the gates whose reader does not know `word` -- the "before" of the fix."""
+    harness = _reader()
+    directory = str(tmp_path / ("no-word-" + word))
+    shutil.copytree(os.path.join(project, ".claude", "hooks"), directory)
+    with open(os.path.join(directory, "_harness.py"), "a", encoding="utf-8") as handle:
+        handle.write(_WITHOUT_A_WORD % (tuple(sorted(set(harness._RESERVED_WORDS) - {word})),))
+    return directory
+
+
+def _cells_for(gate):
+    return sorted((word, template) for word, (template, at) in RESERVED_WORD_CELLS.items()
+                  if at == gate)
+
+
+def _a_shell_that_hands_its_output_back(base):
+    """The first shell on this host that runs a line AND gives THIS process what it printed.
+
+    THE PROPERTY THE ARBITER BELOW NEEDS, and "the process exited 0" is not it. Measured 2026-08-11
+    with the whole suite: from a PATH that puts `C:\\WINDOWS\\system32` first, the shell picked that
+    way is the WSL launcher, and `printf "%s" MARKER` came back returncode 0 with an EMPTY stdout --
+    so every cell of the table would have read "this grammar does not run" and the run would have
+    failed for the launcher instead of for the grammar. Which shell stands first depends on the PATH
+    the suite was started from, which is the root BUG-0014 is about; an earlier draft of this very
+    test carried that defect and this docstring is what it cost.
+    """
+    for candidate in _posix_shells():
+        done = subprocess.run([candidate, "-c", 'printf "%s" MARKER'], cwd=base,
+                              capture_output=True, text=True, timeout=120)
+        if done.returncode == 0 and "MARKER" in done.stdout:
+            return candidate
+    return None
+
+
+def test_every_reserved_word_this_reader_drops_is_measured_and_really_runs(tmp_path):
+    """The table above and the reader's set are one thing, and every cell is a shell that RAN it.
+
+    Two ends, and neither is a sentence: a word the reader drops with no cell is an entry nothing
+    measures, and a cell whose compound a real shell does not run measures a grammar this host does
+    not have. What each word BUYS is measured in the two tests below, one per gate.
+
+    THE ARBITER IS CHOSEN BY WHAT THIS TEST DOES WITH IT (`_a_shell_that_hands_its_output_back`)
+    and not by "it started". The question asked of it -- does this grammar reach the command inside
+    it -- is one every POSIX shell answers the same way, but only a shell whose output comes back
+    can answer it at all. That is a THIRD criterion beside `_can_arbitrate` (does it see this
+    filesystem) and `_reads_the_directory_state_it_is_given` (can this process set its directory
+    state); each test asks for the property it uses, and none of them may be swapped for another.
+    """
+    harness = _reader()
+    assert set(RESERVED_WORD_CELLS) == set(harness._RESERVED_WORDS), (
+        "the reader drops %s and this measurement has cells for %s -- a word on the left that is "
+        "missing on the right is an entry nothing measures, one on the right that is missing on "
+        "the left is a cell measuring nothing"
+        % (sorted(harness._RESERVED_WORDS), sorted(RESERVED_WORD_CELLS)))
+    shell = _a_shell_that_hands_its_output_back(str(tmp_path))
+    assert shell is not None, (
+        "no shell on this host hands this process what it printed, so nothing here could arbitrate "
+        "whether a compound reaches the command inside it: %s" % (_posix_shells(),))
+    for word, (template, _at) in sorted(RESERVED_WORD_CELLS.items()):
+        done = subprocess.run([shell, "-c", template % 'printf "%s" MARKER'],
+                              cwd=str(tmp_path), capture_output=True, text=True, timeout=120)
+        assert "MARKER" in done.stdout, (
+            "%r does not reach the command inside it in a real shell, so the cell for %r measures "
+            "nothing (stderr: %s)" % (template, word, done.stderr[:200]))
+
+
+def test_gate1_reads_the_command_a_reserved_word_opens(project, tmp_path):
+    """BUG-0012, the half the declaration cut left standing: the shell's OWN grammar.
+
+    `_stage_verb` reads the first word of a stage as the verb, and behind `do`, `then`, `else` or
