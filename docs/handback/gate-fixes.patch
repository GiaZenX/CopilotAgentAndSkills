+    """
+    for word, template in _cells_for(GATE1):
+        line = template % ("echo %s" % RELATIVE_TARGET)
+        rc, err = run(project, GATE1, bash_payload(project, line))
+        assert rc == 0, "a read-only command behind %r is refused: %r (%s)" % (word, line, err[:300])
+        rc, _err = run(project, GATE1, bash_payload(project, line),
+                       hooks=_hooks_without(tmp_path, project, word))
+        assert rc == 2, (
+            "%r is in the reader's set and taking it out changes no answer for %r -- the entry is "
+            "dead" % (word, line))
+        writing = template % RELATIVE_WRITE
+        rc, _err = run(project, GATE1, bash_payload(project, writing))
+        assert rc == 2, "a write survived behind %r: %r" % (word, writing)
+
+
+def test_gate3_reads_a_closing_reserved_word_as_the_command_it_is_not(project, tmp_path, open_item):
+    """The same cut at the other reader -- `stage_body` answers for both (BUG-0012, AC-1).
