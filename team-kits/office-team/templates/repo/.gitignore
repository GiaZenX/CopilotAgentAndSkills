# Business documents are NOT tracked: binary PDFs bloat the repo, and GDPR erasure (Art. 17)
# must stay possible — git history is forever. project_memory/, ledger/ (text CSV), reports/
# and manifests ARE tracked. The folder-guide README.txt seeds ARE tracked — `dir/*` + negation,
# NOT `dir/` (git cannot re-include a file whose parent DIRECTORY is excluded; the dir/ form
# silently untracked the kit's own seeds and broke fresh clones).
inbox/*
!inbox/README.txt
archive/*
!archive/README.txt
outbox/*
!outbox/README.txt

# tooling artifacts
__pycache__/
*.pyc
.venv/
venv/

# regenerated state artifacts (spec II.2): index, session brief and dashboard are rebuilt from the
# typed items on every kernel write. Committing them would put a second, always-stale copy of the
# project status in git and produce a merge conflict on every parallel branch.
project_memory/generated/

# the state kernel's cross-process lock (and the remnants a stale-break leaves behind). It names a
# live PID on THIS machine; committed, a clone would inherit a lock nobody holds.
project_memory/.kernel.lock
project_memory/.kernel.lock.stale-*

# append-only hook/agent event log (diagnostic — never project state)
project_memory/.audit/

# GDPR data minimization: these carry counterparty/customer NAMES in target paths (a real
# deployment committed 140 customer names on day 1 — Art.-17 erasure impossible once in
# history), so they stay OUT of git history. `filing_log.yaml` is a V1 store: nothing writes one
# any more and no gate reads one, so the line is purely DEFENSIVE — an upgraded project that still
# carries the file, or a hand-made copy of it, must not walk into history through this template.
# The filing scan index spec II.9 plans needs no rule of its own: it is regenerated, so it lands
# under `generated/` above, which is already ignored. The ledger remains tracked: statutory
# bookkeeping retention overrides erasure there.
project_memory/filing_log.yaml
project_memory/migration_manifest*.yaml

# session-local kit bookkeeping (session_status owns these; per-machine state, never project state)
# a crashed ledger write leaves its lock inside the TRACKED ledger/ tree, where it could be
# committed and would then look like a permanently held lock on every other machine
ledger/*.csv.lock
ledger/*.csv.lock.stale-*
ledger/.*.tmp-*

# the ledger gate's early-warning cache: per machine, regenerated on the next write, and
# NOT authoritative (the block is decided by re-validating). Tracked, a `git checkout` could
# resurrect or erase a stale warning from another machine.
.claude/ledger_state.json
.claude/kit_last_seen_version
.claude/kit_update_pending.state
.claude/project_path.state

# V2 runtime/machine state (spec II.2, II.8): which hook bundle THIS checkout trusts and
# whether a hook has actually run here. Committing it would let a clone inherit `state: active`
# with a matching hash and read as trusted before a single hook ran in it.
.claude/kit_state.json
